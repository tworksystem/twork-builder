{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"category": "twork-builder",
	"textdomain": "twork-builder",
	"name": "twork/blog-article-section",
	"title": "Blog Article Section",
	"description": "",
	"keywords": [
		"brand",
		"shweghee",
		"inner-page"
	],
	"attributes": {
		"author": {
			"type": "string",
			"default": "Shwe Myanmar"
		},
		"category": {
			"type": "string",
			"default": "Product"
		},
		"date": {
			"type": "string",
			"default": "March 15, 2026"
		},
		"dateIso": {
			"type": "string",
			"default": "2026-03-15"
		},
		"title": {
			"type": "string",
			"default": "Introducing Our 10 Viss Bulk Pack"
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": "10 Viss pack"
		},
		"paragraphs": {
			"type": "array",
			"default": [
				"Shwe Myanmar Foodstuff Industry is proud to introduce our flagship 10 Viss bulk butter pack.",
				"Designed for wholesale customers, restaurants, and commercial kitchens across Myanmar."
			]
		},
		"relatedPosts": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
