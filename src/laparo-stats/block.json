{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "twork/laparo-stats",
	"version": "1.0.0",
	"title": "Laparo — Stats band",
	"category": "twork-builder",
	"description": "A hairline band of counted figures under the hero.",
	"keywords": [
		"laparoscopy",
		"stats",
		"figures"
	],
	"attributes": {
		"showSection": {
			"type": "boolean",
			"default": true
		},
		"sectionId": {
			"type": "string",
			"default": ""
		},
		"paddingTop": {
			"type": "number",
			"default": 0
		},
		"paddingBottom": {
			"type": "number",
			"default": 0
		},
		"containerMaxWidth": {
			"type": "number",
			"default": 1200
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		]
	},
	"textdomain": "twork-builder",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
