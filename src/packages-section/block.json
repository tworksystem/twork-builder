				},
				{
					"id": 2,
					"enabled": true,
					"text": "တိကျမှန်ကန်သော ကျန်းမာရေးစစ်ဆေးမှု အဖြေများ"
				},
				{
					"id": 3,
					"enabled": true,
					"text": "အတွေ့အကြုံရှိသော ဆရာဝန်များ၏ တိုင်ပင်ဆွေးနွေးမှုများ"
				},
				{
					"id": 4,
					"enabled": true,
					"text": "တစ်ဦးချင်းစီအလိုက် ကျန်းမာရေးအသိပညာများ ဆွေးနွေးပေးခြင်း"
				},
				{
					"id": 5,
					"enabled": true,
					"text": "သန့်ရှင်းပြီး အရသာရှိသော နံနက်စာဆောင်မှုများ"
				},
				{
					"id": 6,
					"enabled": true,
					"text": "မိမိ၏ ကျန်းမာရေးအဖြေများကို ကွန်ပျူတာထဲတွင် စနစ်တကျ သိမ်းဆည်းပေးထားခြင်း"
				}
			]
		},
