{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"category": "twork-builder",
	"textdomain": "twork-builder",
	"name": "twork/shop-toolbar",
	"title": "Shop Toolbar",
	"keywords": [
		"shop",
		"shweghee",
		"woocommerce"
	],
	"attributes": {
		"resultsText": {
			"type": "string",
			"default": "Showing all products"
		},
		"defaultSort": {
			"type": "string",
			"default": "default"
		},
		"defaultPerPage": {
			"type": "number",
			"default": 12
		},
		"defaultLayout": {
			"type": "string",
			"default": "grid-4"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
